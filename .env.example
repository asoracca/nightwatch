# NightWatch configuration. Copy to `.env` in this directory (the repository root). Never commit `.env`.
# ONE file serves the backend API, the worker, scripts, Docker Compose and the Vite frontend.
# The browser bundle receives only SUPABASE_URL, SUPABASE_ANON_KEY and API_URL (frontend/vite.config.js).

# Supabase (shared). Hosted: https://<project-ref>.supabase.co. Local: http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Server-only: backend and worker. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Frontend → NightWatch API base URL (local API: http://localhost:8000; hosted: your Render URL)
API_URL=http://localhost:8000

# Backend
FRONTEND_ORIGIN=http://localhost:3000
MODEL_PATH=/models/yolo11n.pt
MODEL_VERSION=yolo11n-u8.4.213-t2.15.0
MODEL_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1
MAX_VIDEO_BYTES=52428800
MAX_VIDEO_SECONDS=120
# Storage bucket that holds video_recordings.storage_path (Arduino uploads)
RECORDINGS_BUCKET=

# Vercel server-only (frontend/api/device-events.ts): URL of the Supabase hardware function
HARDWARE_FUNCTION_URL=

# Integration tests only; dedicated disposable test users
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
TEST_VIDEO_PATH=
