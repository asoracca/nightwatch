{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run typecheck && npm test && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://nightwatch-api-r7mk.onrender.com/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
